# Leave this EMPTY in development — Vite proxies /api to the backend for you.
#
# In production set it to your deployed API's origin, with no trailing slash:
#   VITE_API_URL=https://your-api.up.railway.app
#
# It is baked in at build time, so changing it means redeploying the front-end.
VITE_API_URL=
